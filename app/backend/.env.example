# Process environment only; this file is not loaded automatically.
VPN_ENV=production
VPN_DATA_DIR=data
VPN_HTTP_ADDR=127.0.0.1:8080
VPN_LOG_LEVEL=info
VPN_SHUTDOWN_TIMEOUT=10s
# VPN_PUBLIC_ORIGIN=https://vpn.example.com
# Reverse proxies whose X-Forwarded-For identifies clients for rate limiting.
# VPN_TRUSTED_PROXIES=127.0.0.1
