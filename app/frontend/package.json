{
    "name": "veilpost",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "engines": {
        "node": "26.13.1",
        "bun": ">=1.4.4"
    },
    "scripts": {
        "dev": "node scripts/dev.ts",
        "dev:start": "python3 ../../scripts/frontend-dev.py start",
        "dev:stop": "python3 ../../scripts/frontend-dev.py stop",
        "dev:restart": "python3 ../../scripts/frontend-dev.py restart",
        "dev:status": "python3 ../../scripts/frontend-dev.py status",
        "dev:logs": "python3 ../../scripts/frontend-dev.py logs",
        "build": "bun run typecheck && rsbuild build",
        "preview": "rsbuild preview",
        "typecheck": "vue-tsc --noEmit",
        "format": "eslint --fix . && prettier --write .",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "test:e2e": "playwright test",
        "test:dev": "node --test tests/dev/*.test.ts",
        "check": "bun run format:check && bun run lint && bun run build && bun run test:dev && bun run test:e2e"
    },
    "dependencies": {
        "element-plus": "2.14.8",
        "motion-v": "2.12.0",
        "pinia": "4.1.0",
        "pinia-plugin-persistedstate": "4.7.1",
        "vue": "3.5.45",
        "vue-i18n": "11.4.18",
        "vue-router": "5.5.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@iconify-json/lucide": "1.2.152",
        "@playwright/test": "1.65.1",
        "@rsbuild/core": "2.3.3",
        "@rsbuild/plugin-sass": "2.0.1",
        "@rsbuild/plugin-vue": "2.0.1",
        "@types/node": "26.6.6",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-vue": "10.12.0",
        "globals": "17.14.0",
        "jiti": "2.7.0",
        "jsqr": "1.4.0",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.1",
        "unplugin-auto-import": "21.1.0",
        "unplugin-icons": "24.0.0",
        "unplugin-vue-components": "32.1.0",
        "vue-eslint-parser": "10.4.2",
        "vue-tsc": "3.3.14"
    }
}
