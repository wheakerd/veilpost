# Example only. Do not store a real endpoint or secrets in this bundle.
AWG_ENDPOINT_HOST=CHANGE_ME
AWG_LISTEN_PORT=443
AWG_INTERFACE=awg31
AWG_MTU=1280
AWG_STATE_DIR=/var/lib/amneziawg-3.1
AWG_SERVER_IPV4=10.79.31.1/24
AWG_CLIENT_IPV4=10.79.31.2/32
AWG_IPV4_SUBNET=10.79.31.0/24
AWG_SERVER_IPV6=fd79:31:31::1/64
AWG_CLIENT_IPV6=fd79:31:31::2/128
