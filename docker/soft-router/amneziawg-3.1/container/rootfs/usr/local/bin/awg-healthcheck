#!/bin/bash
set -Eeuo pipefail

interface=${AWG_INTERFACE:-awg31}
listen_port=${AWG_LISTEN_PORT:-443}
require_ipv6=${AWG_REQUIRE_IPV6:-true}

ip link show dev "$interface" >/dev/null
awg show "$interface" >/dev/null
[[ $(awg show "$interface" listen-port) == "$listen_port" ]]
[[ $(awg show "$interface" random-trailers) == on ]]
[[ $(awg show "$interface" disable-cookies) == off ]]
[[ $(sysctl -n net.ipv4.ip_forward) == 1 ]]
iptables -w 5 -C INPUT -j AWG31_IN
iptables -w 5 -C FORWARD -j AWG31_FWD
iptables -w 5 -t nat -C POSTROUTING -j AWG31_NAT
/usr/local/bin/awg-firewall verify-native

if [[ $require_ipv6 == true ]]; then
  [[ $(sysctl -n net.ipv6.conf.all.forwarding) == 1 ]]
  ip -6 address show dev "$interface" scope global | grep -q .
  ip6tables -w 5 -C INPUT -j AWG31_IN6
  ip6tables -w 5 -C FORWARD -j AWG31_FWD6
  ip6tables -w 5 -t nat -C POSTROUTING -j AWG31_NAT6
fi
