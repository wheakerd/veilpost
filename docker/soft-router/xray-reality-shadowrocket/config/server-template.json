{
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "__CLIENT_UUID__",
            "email": "shadowrocket",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "dl.google.com:443",
          "xver": 0,
          "serverNames": [
            "dl.google.com"
          ],
          "privateKey": "__REALITY_PRIVATE_KEY__",
          "maxTimeDiff": 60000,
          "shortIds": [
            "__SHORT_ID__"
          ],
          "limitFallbackUpload": {
            "afterBytes": 0,
            "bytesPerSec": 16384,
            "burstBytesPerSec": 32768
          },
          "limitFallbackDownload": {
            "afterBytes": 0,
            "bytesPerSec": 65536,
            "burstBytesPerSec": 131072
          }
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "block"
      }
    ]
  }
}
